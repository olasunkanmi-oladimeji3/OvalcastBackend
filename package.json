{
  "name": "ovalcast-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed.ts",
    "dev": "node scripts/build.mjs --watch",
    "start": "node --enable-source-maps dist/server.js",
    "build": "node scripts/build.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "api:issue": "tsx scripts/issue-api-key.ts",
    "jobs": "node scripts/build.mjs && node --enable-source-maps dist/jobs.js",
    "worker": "node --enable-source-maps dist/worker.js",
    "loadtest": "tsx scripts/loadtest.ts",
    "bench": "tsx scripts/bench.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:setup": "prisma migrate deploy && tsx scripts/db-check.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
