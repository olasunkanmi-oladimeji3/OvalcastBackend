# Copy to .env and adjust.
# production turns off every development behaviour, and the server checks its settings before starting.
NODE_ENV=development
# Staging and production both run NODE_ENV=production; this says which (production if unset).
# Production refuses Flutterwave test keys; staging refuses live ones.
APP_ENV=
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/ovalcast_dev
# Supabase (Project Settings, Database, Connection string). The server uses the transaction pooler:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations need a direct connection (the "Session pooler" string, port 5432, works on IPv4 networks):
#   DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Supabase's SSL certificate (Database, SSL Configuration, Download certificate): a path to the file,
# or its text with \n for line breaks. The connection is then encrypted and fully checked.
#   DATABASE_CA_CERT=./prod-ca-2021.crt
# Then: npm run db:setup (applies migrations, then checks the connection). Never npm run db:seed there.
DIRECT_DATABASE_URL=
DATABASE_CA_CERT=
PORT=4000
LOG_LEVEL=info
# Where uploaded logos and certificates are stored. Swap the storage driver for S3 or R2 later.
STORAGE_DIR=./uploads
PUBLIC_URL=http://localhost:4000
# The website: the stream overlay link OBS loads is built from it. In production, browsers may only
# call the API from this address and CORS_ORIGINS (comma-separated, e.g. the www domain).
WEB_URL=http://localhost:3100
CORS_ORIGINS=
# Development only: return verification codes in API responses instead of sending SMS or email.
DEV_RETURN_CODES=true
# Development only: keep live demo matches moving, one ball every few seconds.
DEMO_SIMULATOR=true
SESSION_DAYS=60
# Required in production: 32 random bytes in base64 (openssl rand -base64 32). Encrypts stream keys
# kept in the database. Keep it safe and never change it, or saved stream keys can't be read.
SECRETS_KEY=

# Speed. One server process needs neither of these.
# Database connections for the whole server, shared out between its processes. Keep it under the
# database's limit (counting anything else connected), or point DATABASE_URL at a pooler (Neon's -pooler host, PgBouncer).
DB_POOL_MAX=20
# With more than one server process, live balls and "this changed" notices go through Redis
# so every process's viewers hear every ball and no process serves an old copy.
REDIS_URL=
# Server processes: a number, or "auto" for one per CPU core. More than one needs REDIS_URL.
# (The server sets OVALCAST_WORKER and OVALCAST_PROCESSES for each process itself; don't set them.)
WEB_CONCURRENCY=1
# off: this server leaves scheduled jobs and partner webhooks to a separate worker (npm run worker).
BACKGROUND_WORK=
# Requests slower than this (ms) are logged; LOG_REQUESTS=true logs every request.
SLOW_REQUEST_MS=500
LOG_REQUESTS=

# Flutterwave: the secret key authorises API calls; the secret hash is set on the
# dashboard and arrives on every webhook as the verif-hash header.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# Where Flutterwave sends app payers afterwards. Website payers go back to WEB_URL/payments/done.
PAYMENT_RETURN_URL=ovalcast://payments/done
# Ovalcast's share of entry fees (2% by default) and of paid streams (25%) are set by staff in the
# backoffice (Staff, Tools, Shares), not here.

# ---- Rate limits and throttling (src/lib/rateLimit.ts)
# Behind a load balancer or CDN, so req.ip is the visitor's address: true, a number of proxies, or their addresses.
TRUST_PROXY=
# Shared secret for trusted callers (the website's server, load tests). Long and random; same value in the web app's env.
INTERNAL_API_TOKEN=
# Multiplies every limit. 1 (unset) in production; 20 for local development and the end-to-end tests.
RATE_LIMIT_SCALE=
# Turn new requests away with 503 when one process has this many in flight, or its event loop lags this much.
MAX_IN_FLIGHT=4000
MAX_EVENT_LOOP_LAG_MS=250

# ---- Verification codes (src/lib/messaging.ts). Production won't start without both.
# SMS: termii (Africa) or twilio (worldwide).
SMS_PROVIDER=
TERMII_API_KEY=
# An approved sender ID; the dnd channel reaches numbers on Do-Not-Disturb (most Nigerian lines).
TERMII_SENDER_ID=Ovalcast
TERMII_CHANNEL=dnd
# Termii's API address; only change it if Termii gives you a different one.
TERMII_BASE_URL=https://api.ng.termii.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Email: postmark or resend, from a verified sending domain.
EMAIL_PROVIDER=
EMAIL_FROM=Ovalcast <codes@ovalcast.app>
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
# A staging server without SMS or email can start anyway, writing codes to the log. Never in production.
ALLOW_CONSOLE_MESSAGING=

# ---- File storage (src/lib/storage.ts)
# local: STORAGE_DIR on this machine (one server, on a disk that survives deploys).
# s3: any S3-compatible store (Cloudflare R2, AWS S3, Backblaze B2), shared by every server.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
# Certificates and rules documents. Not public. Without it they share S3_BUCKET under unguessable keys.
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public address of S3_BUCKET (an R2 custom domain or a CDN), without a trailing slash.
STORAGE_PUBLIC_URL=

# Development only: let partner webhooks go to localhost, for testing them on a laptop. Ignored in production.
ALLOW_LOCAL_WEBHOOKS=
